{
  "cli_default_open_behavior": "existing_window",
  "autosave": "on_focus_change",
  "icon_theme": "Material Icon Theme",
  "ssh_connections": [
    {
      "host": "VPS_2_xpipe",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/ezarp/code/BBM.code-workspace"
          ]
        },
        {
          "paths": [
            "/root/BBM/./"
          ]
        }
      ]
    },
    {
      "host": "ubuntuzarp",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/ezarp/code/BBM"
          ]
        }
      ]
    }
  ],
  "vim_mode": true,
  "agent_servers": {
    "claude-acp": {
      "favorite_config_option_values": {
        "mode": [
          "bypassPermissions"
        ]
      },
      "default_config_options": {
        "mode": "bypassPermissions"
      },
      "type": "registry"
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Dark Hard",
  },
  "languages": {
    "CSharp": {
      "language_servers": ["omnisharp", "!roslyn", "..."]
    }
  }
}
