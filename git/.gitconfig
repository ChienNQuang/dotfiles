[user]
	name = Chien Nguyen Quang
	email = quangchieens1@gmail.com

[includeIf "gitdir:~/code/work/"]
	path = ~/.gitconfig-work

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true
	default = simple

[core]
	pager = delta
	excludesfile = ~/.gitignore_global

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = true

[merge]
	conflictstyle = zdiff3

[diff]
	colorMoved = default

[rebase]
	autosquash = true
	autostash = true

[fetch]
	prune = true
