# Font
font-family = CaskaydiaMono Nerd Font Mono
font-size = 14

# Appearance
theme = Gruvbox Dark Hard
background-opacity = 0.97
background-blur-radius = 20
window-padding-x = 12
window-padding-y = 12
macos-titlebar-style = transparent

# Behavior
copy-on-select = false
confirm-close-surface = false
mouse-hide-while-typing = true
macos-option-as-alt = true
window-save-state = always

# Shell
shell-integration = zsh
command = /opt/homebrew/bin/zellij

# Keybinds
# Route ⌘T to Zellij's "Alt+t" → NewTab binding (defined in ~/.config/zellij/
# config.kdl, active in both normal and locked modes). Sends ESC + 't' which
# Zellij interprets as Alt+t. Stops yabai reflowing on new windows.
keybind = cmd+t=text:\x1bt
